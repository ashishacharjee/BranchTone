{
  "name": "branchtone",
  "version": "0.4.0",
  "description": "BranchTone — Narrative-aware audio QA & regression-testing workbench",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "dev:backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --port 8000 --reload",
    "test": "npm run test --prefix frontend",
    "test:backend": "backend\\.venv\\Scripts\\pytest.exe backend/app/tests",
    "test:all": "npm test && npm run test:backend",
    "typecheck": "npm run typecheck --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  }
}
