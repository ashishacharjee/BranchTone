{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/v1/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|api/).*)",
      "destination": "/index.html"
    }
  ]
}
