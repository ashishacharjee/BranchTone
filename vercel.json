{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/v1/health",
      "destination": "/api/health"
    },
    {
      "source": "/branchtone",
      "destination": "/branchtone.html"
    },
    {
      "source": "/react",
      "destination": "/app.html"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|api/|branchtone\\.html|branchtone|react|app\\.html|master-assets/|thumbnails/).*)",
      "destination": "/index.html"
    }
  ]
}
